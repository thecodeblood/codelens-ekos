# =============================================================================
# CodeLens EKOS — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All variables are prefixed with CODELENS_ in the environment.

# --- Application ---
CODELENS_APP_NAME=CodeLens
CODELENS_APP_VERSION=0.1.0
CODELENS_DEBUG=false

# --- Database ---
CODELENS_DB_PATH=data/codelens.db

# --- LLM (Phase 3 — not used in Phase 1) ---
CODELENS_LLM_PROVIDER=none
CODELENS_LLM_MODEL=llama3.1
CODELENS_LLM_BASE_URL=http://localhost:11434
# CODELENS_OPENAI_API_KEY=sk-...

# --- Ingestion ---
CODELENS_MAX_FILE_SIZE_MB=10
CODELENS_SUPPORTED_LANGUAGES=["python"]

# --- Privacy ---
CODELENS_SEND_SOURCE_CODE_TO_LLM=false
